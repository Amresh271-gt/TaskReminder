<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default (purple) theme, same look as version 1. Light/dark follows the user's choice. -->
    <style name="Theme.TaskReminder" parent="Theme.MaterialComponents.DayNight.DarkActionBar" />

    <!-- Accent colour variants chosen from the menu. -->
    <style name="Theme.TaskReminder.Teal">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryVariant">@color/accent_teal_dark</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
    </style>

    <style name="Theme.TaskReminder.Blue">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_dark</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
    </style>

    <style name="Theme.TaskReminder.Orange">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorPrimaryVariant">@color/accent_orange_dark</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
    </style>

    <style name="Theme.TaskReminder.Pink">
        <item name="colorPrimary">@color/accent_pink</item>
        <item name="colorPrimaryVariant">@color/accent_pink_dark</item>
        <item name="colorSecondary">@color/accent_pink</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
    </style>
</resources>
