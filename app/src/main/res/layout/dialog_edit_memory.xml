<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <EditText
        android:id="@+id/etMemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/mem_hint_title"
        android:inputType="textCapSentences"
        android:maxLines="2" />

    <EditText
        android:id="@+id/etMemContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/mem_hint_content"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="8" />

    <EditText
        android:id="@+id/etMemTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/mem_hint_tag"
        android:inputType="textCapWords"
        android:maxLines="1" />

    <CheckBox
        android:id="@+id/cbMemPinned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mem_pin" />

</LinearLayout>
